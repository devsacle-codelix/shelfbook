generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  maxUnreadBook Int      @default(4)
  createdAt     DateTime @default(now())
}

model Book {
  id            String   @id @default(uuid())
  title         String
  author_name   String
  total_pages   Int
  price         Float
  image         String
  createdAt     DateTime @default(now())
}
